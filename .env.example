# --- Server ---
# Port the Express API listens on
PORT=4000

# Session secret for the httpOnly cookie (use a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Admin password is NOT stored in env. Set it once as a bcrypt hash in DynamoDB:
#   npm run set-admin-password -w server
# (stores pk=ADMIN, sk=PASSWORD in the DynamoDB table)

# AWS region and table name
AWS_REGION=eu-north-1
DYNAMODB_TABLE=partio-tapahtumat

# Google Calendar service account
# Path to the JSON key file downloaded from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account-key.json
# OR the JSON key contents inline (used on Vercel, where the file isn't available)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Email of the calendar to write events to (shared with the service account)
GOOGLE_CALENDAR_ID=your-calendar@group.calendar.google.com

# --- Client ---
# Base URL of the backend API (used by the Vite dev server proxy)
VITE_API_URL=http://localhost:4000
